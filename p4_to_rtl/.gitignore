# Quartus bring-up build outputs (hw/de2-115) -- the .sof files and reports are
# regenerated by `quartus_sh --flow compile`; the sources and .qsf are what matter.
hw/de2-115/*/db/
hw/de2-115/*/incremental_db/
hw/de2-115/*/output_files/
hw/de2-115/*/*.rpt
hw/de2-115/*/*.summary
hw/de2-115/*/*.smsg
hw/de2-115/*/*.jdi
hw/de2-115/*/*.sld
hw/de2-115/*/*.pin
hw/de2-115/*/*.done
hw/de2-115/*/*.qws
hw/de2-115/*/*.sof
hw/de2-115/*/*.qpf
# qsys-generate output: regenerated from the committed .qsys by the command in
# step2_host/de2115_host.qsf's header. The .qsys IS committed; its ~23 generated
# HDL files are not.
hw/de2-115/step2_host/jtag_to_avalon_mst_brg_01/
hw/de2-115/step2_host/*.sopcinfo
