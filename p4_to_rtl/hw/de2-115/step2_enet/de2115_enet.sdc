# de2115_enet.sdc -- two clocks: the board oscillator and the PHY's receive
# clock, which is an INPUT generated by the 88E1111 and not by this design.

create_clock -name CLOCK_50     -period 20.000 [get_ports {CLOCK_50}]

# ENET0_RX_CLK's rate depends on what the PHY negotiated: 2.5 MHz at 10 Mb/s,
# 25 MHz at 100, 125 MHz at 1000 (GMII). Constrained at the FASTEST of those,
# so the analysis is valid whichever one the link settles on -- constraining it
# at 25 MHz would silently under-check a gigabit link.
create_clock -name ENET0_RX_CLK -period 8.000  [get_ports {ENET0_RX_CLK}]

derive_clock_uncertainty

# The two clocks are unrelated: CLOCK_50 is the board crystal, ENET0_RX_CLK is
# recovered by the PHY from the wire. Everything that crosses between them does
# so through the two-flop synchronisers in the design, so the paths must not be
# analysed as if they were synchronous -- without this, Quartus reports failures
# on a crossing that is correct by construction.
set_clock_groups -asynchronous \
    -group [get_clocks {CLOCK_50}] \
    -group [get_clocks {ENET0_RX_CLK}]

# Human-facing and asynchronous board-level signals.
set_false_path -from [get_ports {KEY[*]}] -to *
set_false_path -from [get_ports {SW[*]}]  -to *
set_false_path -from [get_ports {ENET0_LINK100}] -to *
set_false_path -from [get_ports {ENET0_INT_N}]   -to *
set_false_path -from * -to [get_ports {LEDR[*]}]
set_false_path -from * -to [get_ports {LEDG[*]}]
set_false_path -from * -to [get_ports {HEX0[*]}]
set_false_path -from * -to [get_ports {HEX1[*]}]
set_false_path -from * -to [get_ports {HEX2[*]}]
set_false_path -from * -to [get_ports {HEX3[*]}]
set_false_path -from * -to [get_ports {HEX4[*]}]
set_false_path -from * -to [get_ports {HEX5[*]}]
set_false_path -from * -to [get_ports {HEX6[*]}]
set_false_path -from * -to [get_ports {HEX7[*]}]

# MDIO/MDC run at 2.5 MHz against a chip with millisecond-scale requirements;
# the PHY reset is a 10 ms pulse. Neither is a timing-critical path.
set_false_path -from * -to [get_ports {ENET0_MDC}]
set_false_path -from * -to [get_ports {ENET0_MDIO}]
set_false_path -from [get_ports {ENET0_MDIO}] -to *
set_false_path -from * -to [get_ports {ENET0_RST_N}]
set_false_path -from * -to [get_ports {ENET1_RST_N}]
# Transmit is parked at a constant in this step.
set_false_path -from * -to [get_ports {ENET0_GTX_CLK}]
set_false_path -from * -to [get_ports {ENET0_TX_EN}]
set_false_path -from * -to [get_ports {ENET0_TX_DATA[*]}]
set_false_path -from * -to [get_ports {ENET0_TX_ER}]

# The PHY's receive inputs. This step only DETECTS activity on RX_DV (through a
# toggle and a two-flop synchroniser) and never samples the data, so there is no
# setup/hold relationship to check here and these are declared as such -- which
# is also why the unconstrained-input count for this design is zero rather than
# "one we did not look at".
#
# STEP 3 MUST REPLACE THIS. A design that actually samples ENET0_RX_DATA on
# ENET0_RX_CLK needs a real `set_input_delay` derived from the 88E1111
# datasheet's GMII/MII output timing (and, for RGMII, the board's trace skew).
# Leaving these as false paths while decoding frames would mean the data path
# was never timing-checked at all.
set_false_path -from [get_ports {ENET0_RX_DV}]      -to *
set_false_path -from [get_ports {ENET0_RX_DATA[*]}] -to *
set_false_path -from [get_ports {ENET0_RX_ER}]      -to *
